# Repo root — autogen_rp/.gitignore does not apply above that directory.
.env
**/.streamlit/secrets.toml

# OS / editor noise (keep repo root clean)
.DS_Store
Thumbs.db
*.swp
*.swo
.vs/

# Local issue drafting / one-off GitHub helpers (not intended as tracked source)
.github/issue_drafts/
.github/issue-bodies-workflow-efficiency/

# Python bytecode (root-level scripts / stray caches)
__pycache__/
*.py[cod]

# One-off headless harness outputs under validation_runs/ root (keep plan_execution/*.json etc. tracked)
autogen_rp/python/validation_runs/*.log
autogen_rp/python/validation_runs/*metrics*.json
autogen_rp/python/validation_runs/*repro*.json
autogen_rp/python/validation_runs/*survival*.json
autogen_rp/python/validation_runs/*_schedule.json
autogen_rp/python/validation_runs/*_stdout.txt

# Root: local headless LLM simulation tee logs (run_scene_simulation_llm.py)
/*_run*_audit.log

# Local IDE / project exports (not canonical repo content)
_proj_items.json

# One-off validation/investigation harness scripts (e.g. AppTest drives); not production source
autogen_rp/python/validation_runs/**/_run_*.py

# Temporary research / local notes
memplace.txt

# Round A / agent dry-run local outputs (archives & synthetic fixtures; not canonical)
_dry_run_cohort_archive_source/
_dry_run_cohort_artifacts/

# Scratch issue bodies / one-off tooling (local only)
_tmp_hier_edit/
_tmp_prog_issues/

# Local vendor / IDE export (not canonical repo content)
deepseek_v4_overview.rtf
