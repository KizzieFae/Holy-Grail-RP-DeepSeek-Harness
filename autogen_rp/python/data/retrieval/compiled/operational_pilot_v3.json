    "arkham_asylum_mess_hall_arena": [
      {
        "authority_class": "setup_truth",
        "knowledge_id": "335e4d80d8f29204ca0fcc42157fc3b43a4664f254f07c9d35892e927a344228",
        "knowledge_type": "scene_setup_fact",
